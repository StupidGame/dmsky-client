# Public HTTPS endpoint for the Flutter client (DMSKY_PUSH_GATEWAY_URL).
PORT=8080
HOST=0.0.0.0
# docker-compose.yml injects DATABASE_URL from POSTGRES_PASSWORD.
# For direct execution, set DATABASE_URL yourself.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_SSL=false

# 32-byte key encoded as 64 hex characters. Generate with:
# openssl rand -hex 32
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Firebase Admin service account JSON. Use workload identity / ADC in production
# when possible. Do not commit a real service account credential.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required when sending to UnifiedPush/Web Push subscriptions.
VAPID_SUBJECT=mailto:ops@example.invalid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Browser origins allowed to call the gateway. Mobile clients omit Origin.
# Example: https://client.example.com,https://www.example.com
CORS_ORIGINS=

# Poll-free streaming connection: each active account opens one Misskey main stream.
# Do not enable proxy/request logging for Authorization headers or WebSocket URLs.
LOG_LEVEL=info
